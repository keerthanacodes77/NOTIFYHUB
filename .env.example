# NotifyHub Single-Deployment Environment Variables
DATABASE_URL=postgresql://user:password@host:5432/notifyhub?schema=public&sslmode=require
JWT_SECRET=your_random_jwt_secret_key
JWT_EXPIRES_IN=7d
NODE_ENV=production
CLIENT_URL=https://your-notifyhub-domain.vercel.app
COOKIE_SECRET=your_random_cookie_secret_key
