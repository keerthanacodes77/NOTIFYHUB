// NotifyHub Prisma Schema
// Target database: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  ADMIN
}

enum Priority {
  NORMAL
  IMPORTANT
  URGENT
}

enum AnnouncementStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum QueryStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum NotificationType {
  ANNOUNCEMENT
  URGENT_ALERT
  EVENT
  QUERY_REPLY
  SYSTEM
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(STUDENT)
  rollNumber   String?  @unique
  department   String?
  year         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relationships
  announcements  Announcement[] @relation("AdminAnnouncements")
  events         Event[]        @relation("AdminEvents")
  queries        Query[]        @relation("StudentQueries")
  repliedQueries Query[]        @relation("AdminResponses")
  notifications  Notification[] @relation("UserNotifications")
  activityLogs   ActivityLog[]  @relation("AdminLogs")

  @@map("users")
}

model Announcement {
  id             String             @id @default(uuid())
  title          String
  description    String
  category       String // Academic, Examination, Placement, Workshop, Event, General
  priority       Priority           @default(NORMAL)
  status         AnnouncementStatus @default(PUBLISHED)
  department     String? // "All" or specific department like "Computer Science"
  year           String? // "All" or "1st Year", "2nd Year", etc.
  deadline       DateTime?
  attachment     String? // URL or file path in uploads
  attachmentName String? // Original filename
  attachmentSize Int? // Size in bytes
  createdBy      String
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  author User @relation("AdminAnnouncements", fields: [createdBy], references: [id], onDelete: Cascade)

  @@map("announcements")
}

model Event {
  id                   String    @id @default(uuid())
  title                String
  description          String
  date                 DateTime
  startTime            String
  endTime              String
  venue                String
  organizer            String
  registrationEnabled  Boolean   @default(false)
  registrationDeadline DateTime?
  attachment           String?
  attachmentName       String?
  attachmentSize       Int?
  createdBy            String
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  author User @relation("AdminEvents", fields: [createdBy], references: [id], onDelete: Cascade)

  @@map("events")
}

model Query {
  id          String      @id @default(uuid())
  subject     String
  message     String
  status      QueryStatus @default(OPEN)
  response    String?
  studentId   String
  respondedBy String?
  respondedAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  student User  @relation("StudentQueries", fields: [studentId], references: [id], onDelete: Cascade)
  admin   User? @relation("AdminResponses", fields: [respondedBy], references: [id], onDelete: SetNull)

  @@map("queries")
}

model Notification {
  id        String           @id @default(uuid())
  title     String
  message   String
  type      NotificationType @default(ANNOUNCEMENT)
  read      Boolean          @default(false)
  link      String?
  userId    String
  createdAt DateTime         @default(now())

  user User @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model ActivityLog {
  id         String   @id @default(uuid())
  action     String // e.g. "ANNOUNCEMENT_CREATED", "QUERY_RESPONDED", "ADMIN_LOGIN"
  entityType String // "Announcement", "Event", "Query", "Auth", "Settings"
  entityId   String?
  details    String?
  adminId    String
  createdAt  DateTime @default(now())

  admin User @relation("AdminLogs", fields: [adminId], references: [id], onDelete: Cascade)

  @@map("activity_logs")
}
