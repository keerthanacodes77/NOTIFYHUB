# NotifyHub Backend Environment Variables
PORT=5000
NODE_ENV=production
DATABASE_URL=postgresql://user:password@host:5432/notifyhub?schema=public&sslmode=require
JWT_SECRET=your_production_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d
CLIENT_URL=https://your-frontend-domain.vercel.app
COOKIE_SECRET=your_production_cookie_secret_key
